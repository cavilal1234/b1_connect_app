<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sap_connector_dashboard_form" model="ir.ui.view">
        <field name="name">sap.connector.dashboard.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Dashboard SAP" create="false" edit="false" delete="false">
                <sheet>
                    <div class="wrap" style="padding: 20px; background-color: #fff; border-radius: 8px;">
                        <div class="oe_title text-center" style="margin-bottom: 30px; text-align: center;">
                            <h1 style="color: #003366; font-size: 32px; font-weight: bold;">
                                🔌 Conector SAP Business One &amp; Odoo
                            </h1>
                            <h3 style="color: #666;">Por Nova Desarrollos CR</h3>
                        </div>

                        <div class="row" style="margin-top: 20px; font-size: 16px; line-height: 1.6;">
                            <div class="col-12 text-center" style="max-width: 800px; margin: 0 auto; text-align: center;">
                                <p>
                                    Optimice la operación de su empresa sincronizando en tiempo real sus 
                                    <strong>Clientes, Productos, Inventarios y Pedidos de Venta</strong> 
                                    entre Odoo y el SDK DI API o el Service Layer de SAP Business One.
                                </p>
                                <p>
                                    Nuestro conector es la solución ideal para empresas que buscan una integración robusta, 
                                    eficiente y fácil de usar entre sus sistemas ERP. Con una configuración sencilla, 
                                    podrá disfrutar de una sincronización fluida y sin complicaciones.
                                </p>
                            </div>
                        </div>

                        <div class="text-center" style="margin-top: 40px; margin-bottom: 20px; text-align: center;">
                            <a href="https://www.novadesarrolloscr.com/" target="_blank" 
                               class="btn btn-primary btn-lg" 
                               style="background-color: #003366; border-color: #003366; padding: 15px 35px; font-size: 18px; border-radius: 5px; font-weight: bold; color: white; text-decoration: none; display: inline-block; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                                🚀 Solicitar Activación e Integración de API
                            </a>
                        </div>

                        <div class="text-center" style="margin-top: 30px; color: #666; font-size: 14px; line-height: 1.6;">
                            <p>También puede escribirnos a <a href="mailto:soporte@novadesarrolloscr.com" style="color: #003366; text-decoration: none;">soporte@novadesarrolloscr.com</a> o bien a <a href="mailto:proyectosdbadm@gmail.com" style="color: #003366; text-decoration: none;">proyectosdbadm@gmail.com</a> con gusto le contestaremos a la brevedad</p>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sap_connector_dashboard" model="ir.actions.act_window">
        <field name="name">Conector SAP Business One</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sap_connector_dashboard_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_sap_connector_root" 
              name="Conector SAP B1" 
              web_icon="base,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_sap_connector_dashboard" 
              name="Inicio / Activación" 
              parent="menu_sap_connector_root" 
              action="action_sap_connector_dashboard"
              sequence="1"/>
</odoo>